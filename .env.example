# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Every var below is read somewhere in APP/ or eval/;
# nothing here is aspirational.

# ── Auth (required) ─────────────────────────────────────────────────────────
# Signs/verifies session JWTs. Any long random string; rotating it logs
# everyone out. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── LLM generation — pick ONE of OpenAI or Azure OpenAI ─────────────────────
# OpenAI is used for chat generation, RAGAS judging, and (if EMBEDDING_BACKEND
# is unset/openai) embeddings.
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI — used instead of OPENAI_API_KEY when both are set (production
# default). Leave unset to fall back to plain OpenAI above.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-5-mini
AZURE_OPENAI_REASONING_EFFORT=minimal

# ── Embeddings (self-hosted default) ────────────────────────────────────────
# torch = local sentence-transformers model (default, no API cost/latency).
# Set to "openai" to embed via OPENAI_EMBEDDING_MODEL instead.
EMBEDDING_BACKEND=torch
BGE_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=8

# ── Document parsing (ingest) ───────────────────────────────────────────────
# Azure Document Intelligence — primary PDF/DOCX parser.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
# Mistral OCR — used for scanned/image-only pages Doc Intelligence can't read.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
CHUNKING_STRATEGY=structure

# ── Vector store ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks_collection_v2
QDRANT_TIMEOUT_SECONDS=15

# ── OAuth sign-in (both optional; email/OTP sign-in always works without them) ─
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Transactional email (OTP codes) — Azure Communication Services ─────────
ACS_PRIMARY_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# ── Redis (optional) — parsed-document cache, so re-ingesting the same file
# skips Doc Intelligence/OCR. Falls back to in-memory-only caching if unset.
REDIS_URL=
DOC_CACHE_TTL_SECONDS=86400
DOC_CACHE_LOCAL_ENTRIES=4
DOC_CACHE_MAX_REDIS_BYTES=8388608

# ── App / deploy ─────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://vaibhavgit5048.github.io/private-rag-core/
CORS_ALLOWED_ORIGINS=
# Set true only on the production Container App — leave unset/false in dev.
DISABLE_API_DOCS=false
PRIVACY_POLICY_VERSION=1.0
MAX_UPLOAD_BYTES=52428800
MAX_CONTEXT_TOKENS=6000
FLASHRANK_CACHE_DIR=data/flashrank_cache
CHAT_HEALTH_TTL=60

# ── Rate limits (per-user, slowapi syntax) ──────────────────────────────────
LOGIN_RATE_LIMIT=10/minute
QUERY_RATE_LIMIT=60/hour
INGEST_RATE_LIMIT=10/hour

# ── Evaluation harness only (eval/ragas_evaluation.py) ──────────────────────
EVAL_CONCURRENCY=2
GEN_CONCURRENCY=2
