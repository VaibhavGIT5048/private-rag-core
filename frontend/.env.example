# Where the RAG backend lives. Must be NEXT_PUBLIC_ or it is stripped from the
# client bundle and every request silently goes to the wrong origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# When building for GitHub Pages or a shared Docker image, set this to the
# public backend origin you want the frontend to call.

# Public site origin. Derives the OAuth callback URL (must exactly match what
# is registered with GitHub/Google, trailing slash included).
NEXT_PUBLIC_SITE_URL=https://vaibhavgit5048.github.io/private-rag-core/

# Optional: override the GitHub Pages subpath. Leave unset for normal Pages
# deploys; set to an empty string when serving from a custom domain root.
# BASE_PATH=

# OAuth client IDs — public by design (they appear in the redirect URL
# anyway). The matching secrets live only in the backend's .env. Leave both
# unset to disable the GitHub/Google sign-in buttons; email/OTP sign-in
# always works regardless.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
