# syntax=docker/dockerfile:1

# Stage 1: Builder
FROM python:3.14-slim AS builder

WORKDIR /app

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# CPU-only torch, installed BEFORE the main requirements. PyPI's default
# Linux torch wheel bundles full CUDA (nvidia-cublas/cudnn/triton/etc,
# multiple GB) even though bge-m3 only ever runs on CPU here — the same
# GPU-cost trap that ruled out Phi-4 managed compute, just showing up via a
# transitive dependency instead of a model choice. Installing the CPU wheel
# first satisfies sentence-transformers' `torch` requirement without pip
# ever reaching for the CUDA build.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch --index-url https://download.pytorch.org/whl/cpu

# Install dependencies. requirements-api.txt is the live-API subset of
# requirements.txt (drops ragas/datasets/requests, which only the offline
# eval script and Streamlit UI need) — smaller image, faster cold starts.
# The cache mount persists pip's download/wheel cache across builds (in
# BuildKit's build cache, not an image layer), so unchanged packages are
# never re-downloaded even when requirements-api.txt changes.
COPY requirements-api.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-api.txt

# Stage 2: Models
#
# Separate from the builder ON PURPOSE. The obvious place to fetch weights is
# after the app's dependencies are installed — sentence-transformers is right
# there — but a cache miss cascades to every later layer, so any
# requirements-api.txt edit would re-download ~2.3GB. Keyed to fetch_models.py
# alone, this layer survives dependency bumps and code changes alike, and only
# a deliberate edit to the pins rebuilds it.
FROM python:3.14-slim AS models

# hf_transfer is a faster download backend; flashrank is needed to prefetch the
# ranker through its own logic rather than guessing its URL. Neither pulls torch.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "huggingface_hub[hf_transfer]" flashrank
ENV HF_HUB_ENABLE_HF_TRANSFER=1
ENV MODEL_DIR=/opt/models

COPY docker/fetch_models.py /fetch_models.py
RUN python /fetch_models.py

# Stage 3: Runtime
FROM python:3.14-slim

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/home/appuser/app"

# Create a non-root user
RUN useradd --create-home appuser

# Pre-create the volume mount points with correct ownership. data/ subpaths
# (chunks/indexes/evals, rag.db, documents/{owner}/{doc}/) are created on
# demand by the app itself (mkdir(parents=True, exist_ok=True) at each write
# site), so nothing more specific needs pre-creating there.
RUN mkdir -p /home/appuser/app/data \
    && chown -R appuser:appuser /home/appuser/app/data

# Model weights, baked in by the models stage. --chown during COPY rather than a
# following chown -R: a separate ownership pass rewrites every file into a new
# layer, which would put ~2.3GB into the image twice.
COPY --from=models --chown=appuser:appuser /opt/models /opt/models

# Point every loader at the baked copies. NOT ~/.cache/huggingface, which
# docker-compose bind-mounts for local dev — a mount there hides whatever the
# image shipped and sends the app back to downloading at runtime. FLASHRANK_CACHE_DIR
# likewise overrides a default of data/flashrank_cache, which lands on the Azure
# Files share in production and is slow to read.
#
# BGE_MODEL_NAME is a filesystem path, not a repo id: fetch_models.py wrote the
# weights to a plain directory precisely so loading never goes through the hub
# cache, whose repo-id lookup needs a refs/main that a sha-pinned download does
# not create. APP/providers/embedding.py reads this var.
ENV BGE_MODEL_NAME=/opt/models/bge-m3 \
    FLASHRANK_CACHE_DIR=/opt/models/flashrank

USER appuser
WORKDIR /home/appuser/app

# Prove the bake actually resolves, with the network forced off. A wrong path
# fails silently at runtime — the app just downloads again, which is the exact
# behaviour this is meant to remove — so it is worth catching in the build. This
# check already paid for itself once, catching the refs/main problem above.
# Sits above the code COPYs so it stays cached across ordinary commits.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python -c "\
import os; \
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer(os.environ['BGE_MODEL_NAME'], device='cpu'); \
v = m.encode(['offline bake check'], normalize_embeddings=True); \
print('bge-m3 loaded offline from image, dim =', len(v[0]))"

# Copy application code
COPY --chown=appuser:appuser APP/ ./APP/
# prompts/ holds the system prompt and the untrusted-data wrapper. It sits
# outside APP/ so the security rules are reviewable on their own, which
# means it needs copying explicitly — without it the container falls back
# to a minimal prompt and build_rag_payload cannot find its template.
COPY --chown=appuser:appuser prompts/ ./prompts/

# Expose port and run application
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)" || exit 1
CMD ["uvicorn", "APP.main:app", "--host", "0.0.0.0", "--port", "8000"]
